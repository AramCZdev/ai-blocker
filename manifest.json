{
  "manifest_version": 3,
  "name": "AI Blocker",
  "description": "Blocks AI Websites.",
  "version": "unreleased",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
    "declarativeNetRequest"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "redirect-rules.json"
      }
    ]
  },

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "redirectTarget.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
